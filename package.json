{
  "name": "stackpilot",
  "version": "0.3.0",
  "description": "A terminal control plane for managing sites across providers.",
  "type": "module",
  "bin": {
    "stackpilot": "./src/index.tsx"
  },
  "scripts": {
    "dev": "bun run src/index.tsx",
    "start": "bun run src/index.tsx",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "link-global": "bun link",
    "unlink-global": "bun unlink",
    "build:binary": "bun build src/index.tsx --compile --outfile dist/stackpilot"
  },
  "keywords": [
    "stackpilot",
    "tui",
    "terminal-ui",
    "opentui",
    "devops"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@opentui/core": "^0.5.8",
    "@opentui/react": "^0.5.8",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "shell-quote": "1.10.0"
  }
}
