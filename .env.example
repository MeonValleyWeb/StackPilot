# Copy to .env and fill in your provider tokens.

# Vercel: create a token at https://vercel.com/account/tokens
VERCEL_TOKEN=your-token-here
# Optional: restrict requests to a specific Vercel team.
VERCEL_TEAM_ID=

# Netlify: create a personal access token at https://app.netlify.com/user/applications
NETLIFY_API_KEY=

# Cloudflare: create an API token at https://dash.cloudflare.com/profile/api-tokens
# Needs read access to: Account (Pages, Workers Scripts), Zone (Zone).
# Optional: Registrar read access adds domain expiry and renewal information.
CLOUDFLARE_API_TOKEN=
# Optional: pin to one account; otherwise the first visible account is used.
CLOUDFLARE_ACCOUNT_ID=
